    "never_auto_reject": true,
    "minimum_distinctive_signals_for_review": 3,
    "minimum_signals_in_same_bullet_for_review": 2,
    "increase_score_when_missing_concrete_evidence": true,
    "decrease_score_when_present": [
      "named technology",
      "specific tool",
      "specific project",
      "baseline",
      "scale",
      "timeframe",
      "measurable outcome",
      "method or implementation detail"
    ],
    "recommended_label": "Formulaic or insufficiently specific language detected",
    "prohibited_label": "AI-generated resume"
