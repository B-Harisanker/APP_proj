  "structural_flags": {
    "description": "Patterns that may indicate formulaic or insufficiently specific resume bullets. They should trigger review rather than automatic rejection.",
    "patterns": [
      "^(Spearheaded|Orchestrated|Championed|Leveraged|Streamlined|Cultivated|Fostered|Pioneered|Revolutionized)\\s",
      "\\bresulting in\\s+(a|an)?\\s*(significant|substantial|measurable|notable)\\b",
      "\\bplayed\\s+a\\s+(pivotal|key|critical|instrumental)\\s+role\\b",
      "\\bplayed\\s+an\\s+instrumental\\s+role\\b",
      "\\bwas\\s+instrumental\\s+in\\b",
      "\\bcontributed\\s+to\\s+the\\s+successful\\b",
      "\\bhelped\\s+to\\s+drive\\b",
      "\\bhelped\\s+drive\\b",
      "\\bresponsible\\s+for\\s+driving\\b",
      "\\bresponsible\\s+for\\s+leading\\b",
      "\\bdemonstrated\\s+(a|an)\\s+(strong|proven|exceptional)\\b",
      "\\bwith\\s+a\\s+focus\\s+on\\b",
      "\\bwith\\s+the\\s+goal\\s+of\\b",
      "\\bensuring\\s+(seamless|optimal)\\b",
      "\\butilizing\\s+(advanced|cutting-edge|state-of-the-art)\\b",
      "\\bleveraging\\s+(advanced|innovative|cutting-edge)\\b",
      "\\bdriving\\s+(growth|innovation|efficiency|transformation|engagement)\\b",
      "\\benhancing\\s+(efficiency|productivity|performance|user experience)\\b",
      "\\bimproving\\s+(efficiency|productivity|performance|outcomes)\\b",
      "\\boptimizing\\s+(processes|operations|performance|workflows)\\b",
      "\\bdelivering\\s+(impact|value|results|solutions)\\b",
      "\\bcreating\\s+(value|impact|synergy)\\b",
      "\\bfostering\\s+(collaboration|innovation|growth|engagement)\\b",
      "\\bcultivating\\s+(relationships|collaboration|innovation)\\b",
      "\\bempowering\\s+(teams|employees|users|stakeholders)\\b",
      "\\bunlocking\\s+(value|potential|growth|opportunities)\\b",
      "\\bharnessing\\s+the\\s+power\\s+of\\b",
      "\\btransforming\\s+(business|operations|processes|organizations)\\b",
      "\\bseamlessly\\s+integrated\\b",
      "\\bdata-driven\\s+(approach|strategy|solutions|decisions)\\b",
      "\\bcross-functional\\s+collaboration\\b",
      "\\bstakeholder\\s+(alignment|engagement|management)\\b",
      "\\bactionable\\s+insights\\b",
      "\\bmeasurable\\s+(impact|results|outcomes)\\b",
      "\\bquantifiable\\s+(results|impact|outcomes)\\b",
      "\\bkey\\s+(initiatives|objectives|priorities|stakeholders|outcomes)\\b",
      "\\bstrategic\\s+(initiatives|objectives|priorities|approach)\\b"
    ],
    "contextual_percentage_check": {
      "pattern": "\\bby\\s+\\d+%\\b",
      "flag_only_when_missing": [
        "baseline",
        "scale",
        "timeframe",
        "measurement_method",
        "specific_outcome"
      ]
    }
  },
